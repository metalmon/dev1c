# Преднастроенный git для 1С-разработчика.
#
# Задача пилота — познакомить с git людей, которые с ним не работали. Поэтому
# настройки выбраны так, чтобы типовые грабли не всплывали: не спрашивать пароль
# каждый раз, не ломать русские имена, не падать на правах файлов из томов,
# не создавать мусорные merge-коммиты при обновлении.
#
# Имя и почта заданы заглушками, чтобы git не блокировал первый коммит: для
# новичка сообщение "please tell me who you are" — стена на ровном месте.
# Реальные значения проставляет конфигуратор при настройке рабочего места.

[user]
	name = Разработчик 1С
	email = dev@oktaplus.local

[init]
	defaultBranch = main

[core]
	# Выгрузка приходит с Windows, в репозитории держим LF
	autocrlf = input
	# Без этого русские имена файлов показываются как \320\236\321\202\321\207...
	quotepath = false
	# Права файлов из docker-томов отличаются от хостовых — не считаем это
	# изменением, иначе git показывает "изменены" все файлы подряд
	fileMode = false
	editor = nano
	# Хуки образа, а не репозитория: pre-push не пускает в Gitea модуль,
	# который не разбирается (config/git-hooks/pre-push). Путь абсолютный и
	# ведёт внутрь образа — так хук не доезжает с клоном до машины
	# разработчика, где анализатора нет. Отключить на один раз:
	# git push --no-verify.
	hooksPath = /opt/git-hooks

[credential]
	# Пароль/токен Gitea спрашивается один раз и запоминается.
	# Для закрытого контура приемлемо: файл лежит в домашнем каталоге
	# пользователя, который и так защищён паролем RDP.
	helper = store

[pull]
	# Обновление без лишних merge-коммитов. Для новичка это важно: иначе
	# история выгрузки быстро превращается в кашу из "Merge branch main".
	rebase = true

[push]
	# Пушит только текущую ветку и создаёт её на сервере при первом push
	default = current
	autoSetupRemote = true

[fetch]
	prune = true

[diff]
	# XML выгрузки сравнивается читаемее с эвристикой переименований
	renames = true
	algorithm = histogram

[merge]
	conflictStyle = zdiff3

[alias]
	st = status -sb
	co = checkout
	br = branch
	ci = commit
	last = log -1 HEAD --stat
	lg = log --oneline --graph --decorate -20
	# Отменить последний коммит, оставив изменения в рабочем каталоге
	undo = reset --soft HEAD~1
	# Что изменилось в выгрузке с последнего коммита, только имена
	what = diff --name-status

[color]
	ui = auto

[safe]
	# Каталоги приезжают с томов, где uid не совпадает с контейнерным.
	# Без этого git отказывается работать с "dubious ownership".
	directory = *
