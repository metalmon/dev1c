// Преднастроенный конфиг Zed для образа 1С-разработки.
// Копируется каждому рабочему месту в ~/.config/zed/settings.json при сборке.
//
// Принцип: из коробки Zed не делает ни одного сетевого запроса, кроме обращения
// к выбранной модели. Всё остальное — обновления, телеметрия, подсказки
// расширений, edit predictions — выключено явно.
{
  // --- Приватность: ничего наружу ---------------------------------------
  "telemetry": {
    "diagnostics": false, // отчёты о падениях
    "metrics": false // метрики использования
  },
  "auto_update": false, // по умолчанию true: тот самый "Failed to Update"
  "auto_install_extensions": {}, // расширения вморожены при сборке
  "edit_predictions": {
    "provider": "none" // иначе ходит в Zeta на каждое нажатие
  },

  // disable_ai НЕ ставим: агент — смысл этого образа.

  // --- Доверие воркспейсов ----------------------------------------------
  // Без этого Restricted Mode не даёт стартовать language server'у: в логе
  // "Worktree ... is not trusted", и Zed выглядит рабочим, но без диагностики,
  // навигации и автодополнения.
  //
  // Это осознанное ослабление модели безопасности Zed: она защищает от
  // враждебного .zed/settings.json в чужом репозитории. В нашем случае среда
  // контролируемая, проекты — собственные выгрузки заказчика, а требовать от
  // 1С-ника разбираться в модальном окне про доверие — верный способ получить
  // "у меня подсказки не работают".
  // Ключ живёт внутри секции session, на верхнем уровне игнорируется молча.
  "session": {
    "trust_all_worktrees": true
  },

  // --- Язык 1С ----------------------------------------------------------
  // Имя языка из расширения bsl — именно "Bsl".
  // path_suffixes расширения = ["bsl"], файлы OneScript (.os) не покрыты.
  "languages": {
    "Bsl": {
      // Идентификатор сервера — ключ секции [language_servers.bsl] в
      // extension.toml расширения, а не поле name внутри неё.
      "language_servers": ["bsl"],
      "tab_size": 4
    }
  },

  // Расширение bsl заявляет path_suffixes = ["bsl"], поэтому файлы OneScript
  // (.os) не привязаны ни к какому языку: ни подсветки, ни анализатора. Язык у
  // них тот же, что в .bsl, так что достаточно сопоставить расширение вручную.
  "file_types": {
    "Bsl": ["*.os", "*.bsl"]
  },

  // Путь задан явно — при заданном пути расширение не идёт в GitHub за
  // бинарём. Это и есть условие работы в закрытом контуре.
  "lsp": {
    "bsl": {
      "binary": {
        "path": "/opt/bsl-analyzer/bsl-analyzer",
        "arguments": ["lsp"]
      }
    }
  },

  // --- MCP ---------------------------------------------------------------
  // Тот же бинарь умеет отдавать свои возможности модели как MCP-инструменты.
  // Глобальный context_server: Restricted Mode его не блокирует (в отличие от
  // проектных, объявленных в .zed/settings.json).
  // --profile обязателен, без него сервер не стартует и Zed отваливается по
  // таймауту initialize. reference — справочник платформы, проекта не требует.
  // Профиль workspace (--profile workspace -s <корень>) добавляет конфигуратор:
  // он зависит от конкретного проекта.
  "context_servers": {
    "bsl-reference": {
      "source": "custom",
      "command": "/opt/bsl-analyzer/bsl-analyzer",
      "args": ["mcp", "serve", "--profile", "reference"]
      // BSL_CACHE_DIR не задаём. Порядок у анализатора такой:
      // ключ CLI > BSL_CACHE_DIR > штатный кеш системы, а штатный — это
      // ~/.cache/bsl-analyzer, то есть уже у каждого свой. Прописанный здесь
      // абсолютный путь был бы общим на всех пользователей, и первый же
      // сработал бы как чужой: каталог в /home создать некому (сам /home
      // принадлежит root), анализатор молча откатывался бы на штатный кеш —
      // настройка выглядела бы работающей, ничего при этом не делая.
      // Каталог монтируется томом вместе с /home, так что переиндексации при
      // перезапуске контейнера не происходит.
    },
    // Инструменты машины с 1С приходят через обратный SSH-туннель как TCP-порты
    // контейнера: 777N — mcp-1c (живая база: метаданные, запросы, журнал),
    // 778N — vrunner-mcp (сборка, загрузка, тесты), где N — номер рабочего
    // места. На той стороне их запускает 1c-connect; здесь только nc, который
    // переносит stdio MCP в сокет. Порт подставляет entrypoint по имени
    // пользователя при раскладке настроек; параметров у сервера нет намеренно —
    // всё про базу живёт у разработчика в 1c-connect.toml.
    // Туннель не поднят — nc завершается сразу, Zed показывает «сервер
    // недоступен»; после подключения сервер перезапускается кнопкой в Zed.
    // -N: по концу stdin nc закрывает сокет, и процесс на той стороне
    // завершается, а не висит до обрыва туннеля.
    // timeout — предел одного вызова инструмента в секундах; умолчание Zed
    // 60 с. У mcp-1c собственный предел запроса к 1С 300 с, у vrunner
    // выгрузка ЕРП идёт десятки минут.
    "1c": {
      "source": "custom",
      "command": "nc",
      "args": ["-N", "localhost", "WORKSTATION_1C_PORT_PLACEHOLDER"],
      "timeout": 300
    },
    "vrunner": {
      "source": "custom",
      "command": "nc",
      "args": ["-N", "localhost", "WORKSTATION_VRUNNER_PORT_PLACEHOLDER"],
      "timeout": 3600
    }
  },

  // --- Models -----------------------------------------------------------
  // Два провайдера, и ровно один из них рабочий: какой — говорит установщик
  // переменной MODEL_PROVIDER (см. default_model ниже).
  //
  // `llama.cpp` — наш сервер модели: служба на этой машине или соседний
  // контейнер dev1c-llama, видимый как host.docker.internal.
  // `openai_compatible.custom` — чужой сервер (serve = "remote").
  //
  // Адрес, ключ и имя модели приходят переменными LLAMA_API_URL /
  // LLAMACPP_API_KEY либо CUSTOM_API_URL / CUSTOM_API_KEY, имя модели —
  // MODEL_NAME; entrypoint подставляет их вместо заготовок ниже. В
  // репозитории нет ничего нашего, и JSON ради смены сервера никто не правит.
  //
  // Имя переменной ключа диктует Zed: он ищет <ПРОВАЙДЕР>_API_KEY, поэтому
  // LLAMACPP_API_KEY и CUSTOM_API_KEY названы так, а не по нашему вкусу.
  "language_models": {
    // Наш сервер модели: штатный провайдер Zed. Решение владельца 2026-10-21,
    // отменяет прежнее «для Zed модель всегда провайдер custom».
    //
    // Чем он лучше совместимого: окно он забирает с `/props` сам, и объявлять
    // его не нужно — а вместе с объявлением уходит весь класс поломок, за
    // который мы уже заплатили. Раньше установщик считал max_tokens как
    // «окно минус ответ минус запас», потому что Zed трактует max_tokens как
    // ВХОД и просит ответ сверх него; расхождение на единицу рвало поток
    // посреди вызова инструмента, а выглядело как «агент поглупел». Теперь
    // считать нечего: сервер говорит окно, редактор делит его сам.
    //
    // auto_discover — модели сервер перечисляет сам, список в настройках не
    // нужен. Ключ Zed берёт из LLAMACPP_API_KEY: имя переменной диктует имя
    // провайдера, поэтому оно такое, а не наше.
    //
    // Адрес — КОРЕНЬ сервера, без /v1: провайдер сам ходит в /props и
    // /v1/models, и адрес с /v1 дал бы /v1/v1/....
    "llama.cpp": {
      "api_url": "LLAMA_API_URL_PLACEHOLDER",
      "auto_discover": true
    },
    // Чужой OpenAI-совместимый сервер (serve = "remote" в dev1c.toml):
    // штатный провайдер с ним не говорит — у него нет ни /props, ни
    // /v1/models в том виде, который тот ждёт. Поэтому вторая ветвь остаётся,
    // и числа окна здесь объявляются по-прежнему: взять их с сервера нельзя.
    // Прежняя спека убирала эту ветвь ради простоты файла; отказ от простоты
    // осознанный, цена записана в спеке установщика.
    "openai_compatible": {
      "custom": {
        // Full path up to, but excluding, /chat/completions — Zed appends that.
        // A server with a non-standard path looks like
        // https://model.example.com/api/v1/threads
        "api_url": "CUSTOM_API_URL_PLACEHOLDER",
        "available_models": [
          {
            "name": "MODEL_NAME_PLACEHOLDER",
            "display_name": "MODEL_NAME_PLACEHOLDER",
            // Context window and answer size are set separately, on purpose.
            //
            // Zed treats max_tokens as the INPUT and asks for the answer on top
            // of it (a fifth of the declared window when max_output_tokens is
            // absent). Setting max_tokens to the server's total therefore
            // produced a request of total + 20%: the server refused, the stream
            // broke in the middle of a tool call's arguments, and Zed reported
            // "tool input was not fully received". It looked like a broken
            // terminal on one specific command, while in fact everything broke
            // once the thread history grew.
            //
            // Hence the rule the installer follows (llama::zed_numbers):
            // max_tokens = the slot's context (what /props reports, which is
            // slot_n_ctx — a slot's own share, not the pool) MINUS the answer
            // (an eighth of it, within 8192…32768) MINUS a 4096 margin, because
            // Zed counts tokens approximately and the server's own error says
            // "at least". The fallbacks below follow the same rule against a
            // 65536 window: 53248 + 8192 + 4096 = 65536 exactly.
            //
            // The numbers are filled in by the entrypoint: from the measurement
            // dev1c-setup made of the local model server (CUSTOM_MAX_TOKENS,
            // CUSTOM_MAX_OUTPUT_TOKENS), or the entrypoint's own fallbacks
            // (53248 and 32768) for a remote server nobody measured. The
            // output fallback is 32768 because this model reasons, and
            // reasoning sits in the output budget: at 8192 the answer came
            // back empty.
            "max_tokens": CUSTOM_MAX_TOKENS_PLACEHOLDER,
            "max_output_tokens": CUSTOM_MAX_OUTPUT_TOKENS_PLACEHOLDER,
            "supports_tools": true
          }
        ]
      }
    }
  },

  "agent": {
    // --- Профили: что агенту доступно на каком шаге ----------------------
    // Инструментов здесь 44: 17 встроенных Zed и 27 из трёх серверов MCP.
    // Выбор из такого списка модель среднего размера делает наугад, поэтому
    // лишнее выключено, а не «не рекомендовано». Карта «какой инструмент на
    // каком шаге» живёт в AGENTS.md и попадает в контекст всегда.
    //
    // Два механизма, и это не наша прихоть, а устройство Zed:
    // встроенные инструменты — белый список (is_tool_enabled это
    // tools.get(имя) == Some(&true), то есть неперечисленное выключено), а
    // инструменты MCP — чёрный: is_context_server_tool_enabled берёт запись
    // по серверу и имени, а при её отсутствии откатывается на
    // enable_all_context_servers. Поэтому встроенные перечислены полностью, а
    // из 27 инструментов MCP погашены поимённо нужные.
    //
    // Профили заданы своими id, а не правкой штатных write/ask: глубина
    // слияния пользовательских настроек со штатными профилями из бинаря
    // нигде не описана, а полагаться на непроверенное в том, что управляет
    // доступом к cf_load и project_push, нельзя.
    //
    // its_help погашен не по вкусу: он просит токен code.1c.ai, то есть
    // платный внешний сервис, а интернета в контейнере нет — проверено,
    // инструмент отвечает «NAPARNIK_TOKEN not set». Веб-поиск и загрузка
    // страниц (search_web, fetch) по той же причине просто не внесены в
    // список: попытка ими воспользоваться — известный тупик, в котором агент
    // теряет ход. cache_show и cache_clear — обслуживание кеша
    // vanessa-runner, не работа агента.
    "profiles": {
      // Шаг спеки и разбора: агент собирает факты и не трогает базу и код.
      // Это не уговор, а отсутствие инструментов.
      //
      // Граница проходит не по «ничего не менять», а по «не менять базу и
      // выгрузку заказчика». Писать файлы профиль умеет, и это не недосмотр:
      // результат этого шага — design-документ, и профиль, в котором его
      // нельзя сохранить, заводит шаг в тупик. Поэтому write_file и
      // create_directory есть, а edit_file и terminal — нет: править
      // существующий код и запускать что угодно в оболочке на этом шаге
      // незачем.
      //
      // Погашены все инструменты моста, которые меняют состояние на машине
      // разработчика или прерывают её работу: загрузка и выгрузка
      // конфигурации, обновление базы, отправка и приём ветки, прогон тестов
      // (он исполняет код по базе, и данные после него не те, что до) и
      // отмена уже идущей задачи. Читающие — task_status, task_result,
      // validate_syntax_check, project_status — остаются: они факты, а не
      // действия.
      //
      // Этот список пинится тестом рядом с самим перечнем инструментов
      // моста (setup/1c-connect/src/cfg.rs, CHANGES_STATE): новый инструмент
      // при enable_all_context_servers: true пришёл бы агенту включённым и
      // попал бы в «разбор» молча, поэтому забыть обновить профиль нельзя —
      // тест упадёт.
      "разбор": {
        "name": "1С: разбор",
        "tools": {
          "read_file": true,
          "grep": true,
          "find_path": true,
          "list_directory": true,
          "diagnostics": true,
          "skill": true,
          "write_file": true,
          "create_directory": true
        },
        "enable_all_context_servers": true,
        "context_servers": {
          "bsl-reference": { "tools": { "its_help": false } },
          "vrunner": {
            // Список согласован тестом рядом с самим списком инструментов:
            // setup/1c-connect/src/cfg.rs, CHANGES_STATE и
            // the_review_profile_mutes_every_tool_that_changes_state. Новый
            // инструмент моста приходит включённым (enable_all_context_servers),
            // и забыть погасить его тут можно было молча — теперь это падение
            // тестов коннектора, а не находка в работе агента.
            "tools": {
              // Пишет в базу заказчика.
              "cf_load": false,
              "infobase_update": false,
              // Перезаписывает src/ — десятки тысяч файлов и минуты; на
              // разборе это не сбор факта, а правка дерева.
              "cf_decompile": false,
              // Забирает ветку поверх дерева: тот же случай.
              "project_pull": false,
              "project_push": false,
              // Тесты исполняют код по базе: данные после них не те, что до.
              "test_xunit": false,
              "test_vanessa": false,
              "test_yaxunit": false,
              // Снимает уже идущую задачу — чужую работу.
              "task_cancel": false,
              // Обслуживание кеша vanessa-runner, не работа агента.
              "cache_show": false,
              "cache_clear": false
            }
          }
        }
      },
      // Рабочий профиль: всё остальное. Он же по умолчанию.
      "работа": {
        "name": "1С: работа",
        "tools": {
          "read_file": true,
          "grep": true,
          "find_path": true,
          "list_directory": true,
          "diagnostics": true,
          "skill": true,
          "edit_file": true,
          "write_file": true,
          "create_directory": true,
          "terminal": true,
          "spawn_agent": true
        },
        "enable_all_context_servers": true,
        "context_servers": {
          "bsl-reference": { "tools": { "its_help": false } },
          "vrunner": { "tools": { "cache_show": false, "cache_clear": false } }
        }
      }
    },
    "default_profile": "работа",
    // Песочница агента (Zed 1.14+, на Linux это bubblewrap) выключена.
    //
    // Она запрещает запись в .git — и запрещает безоговорочно: документация
    // Zed говорит, что git-метаданные не выдаются ни согласием на отдельный
    // путь, ни allow_fs_write_all, потому что через git-хуки агент вышел бы
    // из песочницы. Для нас это значило «агенту git только на чтение»: ни
    // коммита, ни отправки, причём ошибкой прав доступа на уровне файловой
    // системы, а не внятным отказом инструмента.
    //
    // Отнимала она ровно одно нужное и ничего, что мы берегли: `terminal`,
    // `edit_file` и `write_file` в профиле агенту и так разрешены, стенд —
    // одноразовый контейнер без интернета, а `fetch` и `search_web` в
    // профиль не внесены вовсе. Приехало это молча, с обновлением Zed до
    // 1.25 (версия теперь пинится в Dockerfile).
    "sandbox_permissions": {
      "allow_unsandboxed": true
    },
    // Ремень поверх выключенной песочницы: не граница безопасности (shell у
    // агента есть, обойти эти образцы он сможет), а защита от явной дурости.
    //
    // "default": "allow" стоит только у терминала, и он там обязателен:
    // пропущенное поле Zed читает как "confirm", то есть сам факт появления
    // этого раздела заставил бы подтверждать КАЖДУЮ команду агента — ровно
    // то, ради чего `terminal` ему и выдан.
    //
    // Общего "default" здесь намеренно нет. Он раздал бы «не спрашивать»
    // всем инструментам сразу — и правке файлов, и инструментам моста, — а
    // просили запрет, а не разрешение. Остальные остаются на том, что
    // решает сам Zed. Если после обновления образа агент начнёт спрашивать
    // подтверждение на правку файлов, ручка здесь: добавить `edit_file` и
    // `write_file` в `tools` со своим "allow", поимённо.
    //
    // Образцы — регулярные выражения Rust по строке команды, регистр не
    // важен по умолчанию. Zed разбирает цепочки (`echo x && sudo y`) и
    // проверяет каждую команду отдельно, поэтому sudo привязан к началу.
    // rm не привязан: он приходит и после `xargs`, и из `find -exec`.
    // `rm --recursive --force` этими образцами не ловится — писать такое
    // случайно никто не станет, а от умышленного ремень и не спасает.
    "tool_permissions": {
      "tools": {
        "terminal": {
          "default": "allow",
          "always_deny": [
            { "pattern": "^\\s*sudo\\b" },
            { "pattern": "\\brm\\s+-[^\\s]*r[^\\s]*f\\b" },
            { "pattern": "\\brm\\s+-[^\\s]*f[^\\s]*r\\b" }
          ]
        }
      }
    },
    // В контейнере нет управления питанием, и запрос «не засыпать» уходит в
    // портал, который отвечает отказом. Zed считает это ошибкой агентского
    // потока: в логе «Failed to prevent idle sleep», и агент не отвечает.
    "prevent_idle_sleep": false,
    // Панель агента справа: слева проводник с файлами конфигурации, и
    // перекидывать его ради чата каждый раз неудобно. По умолчанию Zed ставит
    // агента слева, конфликтуя с проводником.
    "dock": "right",
    // Default model: the one the custom provider names; the entrypoint fills
    // the name in from CUSTOM_MODEL, so the environment uses whichever model
    // dev1c-setup configured, with no editing by hand.
    // Какой из двух провайдеров выше рабочий, решает установщик и говорит
    // переменной MODEL_PROVIDER: файл настроек один на все рабочие места, и
    // выбирать ветку в нём некому.
    "default_model": {
      "provider": "MODEL_PROVIDER_PLACEHOLDER",
      "model": "MODEL_NAME_PLACEHOLDER"
    }
  },

  // --- Интерфейс --------------------------------------------------------
  // Темы 1С (themes/1c.json): палитра Такси, та же, что у окна 1c-connect.
  // Режим light по умолчанию: Конфигуратор и EDT светлые, 1С-разработчик
  // привык к ним. Тёмная доступна переключением, ставить её по умолчанию для
  // этой аудитории — не «современно», а непривычно.
  "theme": {
    "mode": "light",
    "light": "1C Light",
    "dark": "1C Dark"
  },
  // Zed не наследует Xft.dpi: масштаб системы на него не влияет, размер задаётся
  // только здесь. По RDP мелкий шрифт читается хуже, чем локально (сжатие
  // картинки), поэтому берём на ступень крупнее привычного.
  // Курсор не мигает. Zed рисует кадр целиком шейдерами, и в стенде это
  // делает процессор: карты для отрисовки там нет (в WSL её не будет
  // вовсе, см. леджер). Мигающий курсор — это полный кадр дважды в
  // секунду вечно, даже когда в редакторе никто не сидит, и на восьми
  // ядрах растеризатора это заметно всей машине, включая 1С и сервер
  // модели. Статичный курсор в терминальной работе привычен.
  "cursor_blink": false,
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_size": 17,
  "ui_font_family": "Inter",
  "ui_font_size": 17,
  "agent_ui_font_size": 17,
  "agent_buffer_font_size": 17,

  // Онбординг и всё, что относится к аккаунту Zed: в этой среде аккаунта нет,
  // модель подключается своя. Баннеры и кнопки входа только мешают.
  "title_bar": {
    "show_onboarding_banner": false,
    "show_sign_in": false,
    "show_user_picture": false,
    "show_user_menu": false
  },
  // Classic layout. В Zed это не одна настройка, а набор дефолтов для доков:
  // «Agentic» (по умолчанию) ставит проводник и структуру справа, агента слева;
  // «Classic» — наоборот. Второй вариант привычен тем, кто пришёл из любой
  // другой IDE, включая Конфигуратор и EDT: дерево объектов слева.
  // Положение агента задано в секции "agent" выше.
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },

  // Git в Zed снова включён (25.10.2026).
  //
  // Выгрузка ЕРП — репозиторий на 67 тысяч файлов, и git-интеграция на таком
  // дереве действительно становится источником нагрузки: статус
  // переспрашивается по тысячам каталогов, один вызов стоит десятки секунд
  // процессорного времени. Выключателем `disable_git` мы её и выключили — он
  // настоящий (zed PR #43326), но фоновые вызовы git им не прекращаются, об
  // этом пишут в zed-industries/zed#13304 и на 0.230, и на 1.4.4. То есть
  // интерфейс мы отдали, а нагрузку не сняли.
  //
  // Поэтому наоборот: интеграция на месте, а цена прижата теми ручками,
  // которые работают. Значения щедрые нарочно — на выгрузке важнее не
  // занимать ядра, чем показать изменение на полсекунды раньше; мерить их
  // всё равно только на живой выгрузке.
  "git": {
    // По умолчанию 0 — то есть полоса изменений пересчитывается без задержки
    // вовсе, на каждую правку.
    "gutter_debounce": 3000,
    // Подписи авторов в коде: на каждую строку отдельный `git blame`.
    "inline_blame": {
      "enabled": false
    }
  },

  // Индикаторы изменений на полосе прокрутки — ещё один обход статуса по
  // всему файлу; по умолчанию включены.
  "scrollbar": {
    "git_diff": false
  },

  // Остальные задержки, не про git: на дереве выгрузки каждая из них
  // стреляет часто, а запросы уходят в bsl-analyzer на той же машине, где
  // работает 1С. В скобках — значение по умолчанию.
  "lsp_highlight_debounce": 1000,
  "hover_popover_delay": 1000,
  "inlay_hints": {
    "edit_debounce_ms": 3000,
    "scroll_debounce_ms": 1000
  },

  // Выгрузка ЕРП — сотни тысяч файлов. Без исключений Zed индексирует служебные
  // каталоги и кеши, и поиск по проекту становится заметно медленнее.
  "file_scan_exclusions": [
    "**/.git", "**/.svn", "**/.hg", "**/CVS", "**/.DS_Store",
    "**/node_modules", "**/.venv", "**/__pycache__",
    "**/.cache", "**/build", "**/dist",
    "**/ConfigDumpInfo.xml"
  ],

  "terminal": {
    // zsh, как и в обычном терминале стенда: подсказка при наборе из
    // истории и подсветка неверной команды. Входная оболочка остаётся
    // bash — её ждут скрипты и ssh.
    "shell": {
      "program": "/usr/bin/zsh"
    },
    // Тот же моноширинный шрифт, что в редакторе
    "font_family": "JetBrains Mono",
    "font_size": 15,
    "copy_on_select": true
  }
}
