[Configuration]
# Оболочку здесь не задаём: ключи RunCustomCommand/CustomCommand этот
# xfce4-terminal (1.1.4) не применяет — проверено и на полном файле, и
# на голом из двух строк, дочерним процессом всё равно оставался bash,
# хотя прочие ключи отсюда действуют. zsh приходит входной оболочкой
# рабочего места (chsh в Dockerfile), и терминал запускает именно её.
# Копирование выделением: выделил мышью — уже в буфере. Так Ctrl+C
# остаётся прерыванием команды, а не копированием (решение владельца
# продукта 20.10.2026): отдать Ctrl+C под копирование значит отнять у
# человека единственный способ остановить работающую команду.
MiscCopyOnSelect=TRUE
# Вставка на Ctrl+V — привязка в accels.scm рядом. Средняя кнопка мыши
# вставляет первичное выделение, как принято в X11.
MiscMiddleClickOpensUri=FALSE

# Гость приходит на час и уходит; история прокрутки ему нужна целиком,
# а не последние пятьсот строк: он будет искать в ней, что ответил git.
ScrollingUnlimited=TRUE
ScrollingOnOutput=TRUE

# Шрифт крупнее стандартного: стенд смотрят по RDP, часто на чужом
# мониторе и через уменьшенное окно клиента.
FontName=Monospace 12
FontUseSystem=FALSE

# Заголовок окна — рабочее место и каталог; в онбординге мы говорим
# «откройте терминал», и человек должен отличать его окна друг от друга.
TitleMode=TERMINAL_TITLE_REPLACE
MiscDefaultGeometry=100x28
MiscMenubarDefault=FALSE
MiscToolbarDefault=FALSE
MiscConfirmClose=FALSE
