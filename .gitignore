# Parameters now live in dev1c.toml of a kit, which is never in the repository;
# a leftover .env from the script days stays ignored for the same reason it
# always was: a key that lands in a public history stays there.
.env
.env.*
# The working kit on this machine and anything .superpowers writes
.superpowers/

# Release archives and model files: both weigh more than the repository
dist/
models/
*.tar
*.tar.gz
*.gguf

# The NVIDIA Container Toolkit .deb files the build fetches into the
# repository root (mkdir -p nvidia-container-toolkit) for the Linux kit
nvidia-container-toolkit/

# Local run state
.ports
*.log

# Rust build output of the installers
setup/target/

# The 1C training installer for Dockerfile.1c (download it from the 1C site)
platform/

# CI artifacts for Dockerfile.1c (1c-connect-linux): their own small build
# context, so a rebuild of the stand image does not drag the 1C installer
artifacts/

# Рабочие копии git для параллельных ветвей
.worktrees/

# Python bytecode of the onboarding overlay
__pycache__/
*.pyc
