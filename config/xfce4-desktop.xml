<?xml version="1.0" encoding="UTF-8"?>
<!--
  Обои рабочего стола.

  ponytail: имена мониторов перечислены пачкой намеренно. xfdesktop ключует
  обои по имени выхода RANDR, а в xrdp-сессии оно зависит от версии xorgxrdp и
  клиента (rdp0 / default / monitor0). Заранее его не узнать, промахнуться —
  значит получить серый фон вместо обоев. Лишние ветки xfdesktop игнорирует,
  цена ошибки ноль. Если когда-нибудь имя станет известно точно — оставить одну.

  image-style=5 — zoom: заполнить экран с сохранением пропорций. RDP-сессия
  открывается в произвольном разрешении под окно клиента, растягивать нельзя.
-->
<channel name="xfce4-desktop" version="1.0">
  <property name="backdrop" type="empty">
    <property name="single-workspace-mode" type="bool" value="true"/>
    <property name="single-workspace-number" type="int" value="0"/>
    <property name="screen0" type="empty">
      <property name="monitor0" type="empty">
        <property name="workspace0" type="empty">
          <property name="last-image" type="string" value="/usr/share/backgrounds/dev1c.jpg"/>
          <property name="image-style" type="int" value="5"/>
          <property name="color-style" type="int" value="0"/>
          <property name="rgba1" type="array">
            <value type="double" value="0.027"/>
            <value type="double" value="0.059"/>
            <value type="double" value="0.102"/>
            <value type="double" value="1.0"/>
          </property>
        </property>
      </property>
      <property name="monitorrdp0" type="empty">
        <property name="workspace0" type="empty">
          <property name="last-image" type="string" value="/usr/share/backgrounds/dev1c.jpg"/>
          <property name="image-style" type="int" value="5"/>
        </property>
      </property>
      <property name="monitordefault" type="empty">
        <property name="workspace0" type="empty">
          <property name="last-image" type="string" value="/usr/share/backgrounds/dev1c.jpg"/>
          <property name="image-style" type="int" value="5"/>
        </property>
      </property>
      <property name="monitorscreen" type="empty">
        <property name="workspace0" type="empty">
          <property name="last-image" type="string" value="/usr/share/backgrounds/dev1c.jpg"/>
          <property name="image-style" type="int" value="5"/>
        </property>
      </property>
    </property>
  </property>
  <property name="desktop-icons" type="empty">
    <property name="style" type="int" value="2"/>
    <property name="icon-size" type="uint" value="48"/>
    <property name="single-click" type="bool" value="false"/>
    <property name="file-icons" type="empty">
      <property name="show-filesystem" type="bool" value="false"/>
      <property name="show-removable" type="bool" value="false"/>
      <property name="show-trash" type="bool" value="false"/>
      <property name="show-home" type="bool" value="true"/>
    </property>
  </property>
</channel>
