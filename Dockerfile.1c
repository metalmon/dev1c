# syntax=docker/dockerfile:1.7
# =============================================================================
# The demo stand: the training 1C platform on top of the dev1c image.
#
# A second layer rather than a change to the main Dockerfile: the installer is
# 1.7 GB and lives on nobody's CI runner (the 1C site hands it out through a
# browser form), so this layer is built where the file is and the main image
# keeps building in GitHub Actions untouched.
#
# The file builds two things, and the heavy one is NOT the image:
#
#   docker build -f Dockerfile.1c --build-context artifacts=artifacts \
#                -t oktaplus/dev1c-1c:latest .
#       the stand image — the tools, the launchers, the runtime. No platform,
#       no demo base: about 4 GB, and a change to stand.sh costs one layer.
#       It does NOT take the platform context: the only thing it needs from
#       outside the repository is the 1c-connect binary, and that lives in
#       `artifacts/` so a rebuild moves 68 MB instead of 3.8 GB.
#
#   docker build -f Dockerfile.1c --build-context platform=platform \
#                --target payload -t oktaplus/dev1c-1c-payload:latest .
#       the payload — /opt/1cv8t (the platform) and /opt/1c-demo (the template
#       base), about 4 GB more. It is built once per platform/configuration
#       version and shipped as a tar that fills two named volumes:
#           dev1c-platform -> /opt/1cv8t
#           dev1c-demo     -> /opt/1c-demo
#       `1c-stand export-payload` writes that tar, `1c-stand import-payload`
#       unpacks it into the mounted volumes, and `setup/1c/provision.sh` is the
#       host side of both. Until the volumes are filled, `1c-stand start` says
#       so and exits instead of failing somewhere deep.
#
# Why volumes: the platform and the demo base change with their own releases,
# not with ours. Baked in, every change to the stand meant moving 11 GB — of a
# build context, of an image, of a kit. In volumes the image stays light, the
# payload is delivered once, and a customer who already has it keeps it across
# image updates.
#
# `platform/` holds setup-training-<version>-x86_64.run, unpacked from the
# tar.gz of the 1C download page, and the demo template; `artifacts/` holds
# what CI built. Both are separate build contexts so the main context never
# carries them (see .dockerignore too), and they are separate from each other
# so each target transfers only what it uses. The base image tag is an
# argument: --build-arg BASE=oktaplus/dev1c:<tag>.
#
# What the spike of 2026-10-18 established, and this file encodes:
#   - the training edition ships client_full + ws only: file bases, no server,
#     no ibcmd; it installs into /opt/1cv8t and every binary carries a "t"
#     suffix (1cv8t, 1cv8ct, webinstt, wsap24t.so);
#   - Debian 13 has no webkit2gtk-4.0, which the binaries link; 1C ships
#     ".wk41" variants of the two affected libraries, and pointing the
#     symlinks at them makes ldd clean;
#   - vanessa-runner only knows /opt/1cv8/x86_64/<version>/1cv8 — a symlink
#     farm gives it that name;
#   - the training edition allows ONE Enterprise session per base (a second
#     one answers "Infobase connections limitation reached"); the Configurator
#     coexists with it. The runtime (bases, publication, the 777N/778N
#     listeners) is config/1c/stand.sh, the CMD of this image.
# =============================================================================

ARG BASE=oktaplus/dev1c:latest
ARG PLATFORM_VERSION=8.5.1.1150

# --- vanessa-runner library tree ---------------------------------------------
# Resolved by opm inside the project's OneScript image, exactly as pack.sh does
# for the developer's kit, and checked against the same manifest: hub.oscript.io
# serves "what it has today", and two images of the same version must not
# differ silently.
FROM evilbeaver/onescript:2.2.0 AS vrunner
ARG VRUNNER_VERSION=3.0.2
ARG ADD_VERSION=6.8.0
COPY setup/1c-connect/vendor/vrunner-lib.sha256 /manifest
RUN opm install -d /out vanessa-runner@${VRUNNER_VERSION} add@${ADD_VERSION} >/dev/null \
    && cd /out && sha256sum -c --quiet /manifest \
    && [ "$(find . -type f | wc -l)" = "$(wc -l </manifest)" ] \
    && test -f vanessa-runner/src/mcp.os

# =============================================================================
# tools — everything both the stand image and the payload build need
# =============================================================================
FROM ${BASE} AS tools
ARG DEBIAN_FRONTEND=noninteractive
ARG PLATFORM_VERSION
ARG MCP_1C_VERSION=v1.22.3
# Re-declared from the "vrunner" stage (ARGs do not cross stages on their
# own, see PLATFORM_VERSION above): only needed here to stamp the kit's own
# tools.version (built below).
ARG VRUNNER_VERSION=3.0.2
ARG ADD_VERSION=6.8.0

# webkit 4.1 + GLU: the client's own dependencies (v8_install_deps is disabled
# in the payload stage — it would apt on its own, outside our control).
# xvfb + xauth: the Configurator in batch mode still wants a display. apache2:
# the HTTP service of the base for mcp-1c, published with webinstt at run time.
# It is linked into /usr/local/bin further down — the package puts it in
# /usr/sbin, which only root has on PATH, and 1c-connect calls it BY NAME.
RUN apt-get update && apt-get install -y --no-install-recommends \
      libwebkit2gtk-4.1-0 libglu1-mesa xvfb xauth apache2 socat \
      `# libayatana-appindicator3: the tray icon of 1c-connect in local mode.` \
      `#   The panel's systray plugin shows StatusNotifier items, and tray-icon` \
      `#   (the crate 1c-connect uses) talks to them through this library.` \
      `#   Verified in the image with a test indicator: the icon appears in the` \
      `#   panel next to the clock.` \
      libayatana-appindicator3-1 \
      `# dev1c-onboarding: семь шагов поверх рабочего стола (config/1c/` \
      `# onboarding/) — чистый GTK3, без собственного композитора; xprop и` \
      `# xwininfo (x11-utils) ему тоже нужны, но они уже стоят в базовом` \
      `# образе ради других задач. wmctrl — вежливое закрытие окна 1С на` \
      `# шаге 3 (_NET_CLOSE_WINDOW, не kill): ни xprop/xwininfo, ни Gdk не` \
      `# умеют послать это сообщение, только самостоятельный Xlib-код или` \
      `# готовый инструмент — взят инструмент, он на это и есть.` \
      python3-gi python3-gi-cairo gir1.2-gtk-3.0 wmctrl \
    && rm -rf /var/lib/apt/lists/*

# --- mcp-1c: the Linux binary and the extension ------------------------------
# The same release as the developer's kit (pack.sh), pinned by the hashes of
# its checksums.txt. The .cfe is applied to the demo base in the payload stage.
RUN curl -fsSL -o /usr/local/bin/mcp-1c \
      "https://github.com/feenlace/mcp-1c/releases/download/${MCP_1C_VERSION}/mcp-1c-linux-amd64" \
    && echo "8118fa6005e6a6c4add82d920142254f97e82a5d7bd7856b3d2276dd216abd92  /usr/local/bin/mcp-1c" | sha256sum -c --quiet \
    && chmod +x /usr/local/bin/mcp-1c \
    && mkdir -p /opt/mcp-1c \
    && curl -fsSL -o /opt/mcp-1c/MCP_HTTPService.cfe \
      "https://github.com/feenlace/mcp-1c/releases/download/${MCP_1C_VERSION}/MCP_HTTPService.cfe" \
    && echo "76df5ccf993c10caef73fe8399d2fa7df1cc3b7e9b24fc6662ab402aeea1bf61  /opt/mcp-1c/MCP_HTTPService.cfe" | sha256sum -c --quiet \
    && mcp-1c --version

# --- vanessa-runner ----------------------------------------------------------
# Its own tree under /opt/vrunner: the dependencies are vendored in its
# oscript_modules, so nothing is added to the image's OneScript library.
# vrunner-mcp is the MCP server Zed talks to on 778N; the CLI is not wrapped
# (its argument parser fails under oscript 2.2.0 on Linux — the MCP path is the
# one that matters).
COPY --from=vrunner /out /opt/vrunner
RUN printf '#!/bin/sh\nexec oscript /opt/vrunner/vanessa-runner/src/mcp.os "$@"\n' > /usr/local/bin/vrunner-mcp \
    && chmod +x /usr/local/bin/vrunner-mcp \
    # Smoke test: the server answers tools/list with the tools the bridge
    # relies on. stdin is held open for a while: the server exits on EOF.
    && ( printf '%s\n%s\n%s\n' \
         '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2024-11-05","capabilities":{},"clientInfo":{"name":"build","version":"0"}}}' \
         '{"jsonrpc":"2.0","method":"notifications/initialized"}' \
         '{"jsonrpc":"2.0","id":2,"method":"tools/list"}'; sleep 30 ) \
       | timeout 300 vrunner-mcp > /tmp/tools.json \
    && grep -q '"cf_decompile"' /tmp/tools.json && grep -q '"cf_load"' /tmp/tools.json \
    && echo "vrunner-mcp: $(grep -oE '"name":"[a-z_0-9]+"' /tmp/tools.json | sort -u | wc -l) tools" \
    && rm /tmp/tools.json

# --- the shared kit: /opt/dev1c-kit ------------------------------------------
# One kit, built here and nowhere else, under the exact names
# ops_host.rs expects (mcp_exe/oscript_exe/vrunner_lib/git_exe — the single
# place that spells out the shape; this step must only ever link to it, never
# repeat it). Every workstation's home is a volume (see stand.sh), so nothing
# baked under /home/devN survives a restart — this is why the kit lives at a
# fixed path instead, and why `seed` no longer links any of this per login.
# Links, not copies: the kit is read-only and these binaries already live on
# the same image layer, so a symlink costs nothing and stays honest about
# where the real file is.
#
# tools.version here is the KIT's own stamp — what was shipped, written once
# now and never touched again. It is NOT the same file as the one `host.tools`
# writes into tools_dir() at install time (what is actually laid out on a
# given machine) — `ops_host::tools_state` compares the two.
RUN mkdir -p /opt/dev1c-kit/vrunner/bin /opt/dev1c-kit/git/bin \
    && ln -s /usr/local/bin/mcp-1c /opt/dev1c-kit/mcp-1c-linux-amd64 \
    && ln -s /opt/mcp-1c/MCP_HTTPService.cfe /opt/dev1c-kit/MCP_HTTPService.cfe \
    && ln -s "$(command -v oscript)" /opt/dev1c-kit/vrunner/bin/oscript \
    && ln -s /opt/vrunner /opt/dev1c-kit/vrunner/lib \
    && ln -s "$(command -v git)" /opt/dev1c-kit/git/bin/git \
    && printf 'OneScript 2.2.0; vanessa-runner %s; add %s; mcp-1c %s\n' "${VRUNNER_VERSION}" "${ADD_VERSION}" "${MCP_1C_VERSION}" >/opt/dev1c-kit/tools.version \
    && echo "комплект: $(find /opt/dev1c-kit | wc -l) записей, $(cat /opt/dev1c-kit/tools.version)"
# Every workstation process sees this: the desktop autostart (1c-stand
# connect -> 1c-connect --tray) and a hand-run `1c-connect serve` alike — an
# image-wide ENV reaches both without stand.sh having to export it itself.
ENV ONEC_CONNECT_KIT=/opt/dev1c-kit
# Belt for a login shell: a desktop session comes through xrdp-sesman and PAM,
# which do not have to carry the image's ENV, and someone who runs
# ~/dev1c/1c-connect by hand from that session's terminal would otherwise fall
# back to a kit with no tools in it. stand.sh defaults the variable itself for
# every path that goes through it (see its header) — this covers the rest.
RUN echo 'export ONEC_CONNECT_KIT=/opt/dev1c-kit' >/etc/profile.d/dev1c-kit.sh

# --- fonts -------------------------------------------------------------------
# 1C greets a session with «На сервере отсутствуют шрифты из состава Microsoft
# Core Fonts» and warns that the interface may look wrong: its layouts are
# measured in Arial, Times New Roman and Courier New. The Debian installer
# fetches the original self-extracting archives from SourceForge — the way
# Microsoft allowed them to be redistributed — so this step needs the network
# at build time and lives in contrib.
RUN sed -i 's/^Components: main$/Components: main contrib/' /etc/apt/sources.list.d/debian.sources \
    && echo "ttf-mscorefonts-installer msttcorefonts/accepted-mscorefonts-eula select true" | debconf-set-selections \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ttf-mscorefonts-installer \
    && rm -rf /var/lib/apt/lists/* \
    && fc-list | grep -q "Arial" \
    && echo "ms core fonts: $(fc-list | grep -ciE 'arial|times new roman|courier new') faces"

# --- the names the platform volume fills in ----------------------------------
# vanessa-runner knows exactly one path to the Configurator,
# /opt/1cv8/x86_64/<version>/1cv8, and the training edition installs into
# /opt/1cv8t with "t"-suffixed binaries. Two symlinks give it that name, and
# they are made here rather than in the payload so that an image without the
# volume still has the shape — a dangling link is a readable failure, a missing
# one sends vanessa-runner looking for a platform it will never find.
ENV PLATFORM_VERSION=${PLATFORM_VERSION}
RUN ln -s /opt/1cv8t /opt/1cv8 \
    && ln -s /opt/1cv8/x86_64/${PLATFORM_VERSION}/1cv8 /usr/local/bin/1cv8

# --- the runtime script ------------------------------------------------------
# In `tools` because the payload build uses it too: `1c-stand publish` checks
# the demo base template at build time (below, port 8089). It is no longer
# how a workstation's base gets published at run time — the connector does
# that itself (host.publication, its own Apache under $HOME/dev1c/pub) — so
# this is a build-time-only check now, not a mirror of the running stand.
# DEMO_DB_USER: the infobase user the configuration's welcome wizard made in
# the template base (see the payload stage). The publication, the base list and
# vrunner all read it from here. Empty means a base with no users at all.
ARG DEMO_DB_USER=Администратор
ENV DEMO_DB_USER=${DEMO_DB_USER}

# DEMO_TITLE: what the base is called in the starter's list — the first words
# about this stand a person reads. It belongs next to DEMO_DB_USER because
# both describe the same demo base and both change with DEMO_TEMPLATE; it was
# a string inside the seed before, and the list went on saying «Управление
# нашей фирмой» for a base that had not been УНФ for a day.
# Кавычки обязательны: ARG и ENV без них режут значение по первому пробелу,
# и в образ приезжает одно слово. Поймано проверкой образа после сборки —
# `docker run ... echo $DEMO_TITLE` напечатал «Демонстрационное».
ARG DEMO_TITLE="Управление нашей фирмой (учебная)"
ENV DEMO_TITLE="${DEMO_TITLE}"
# apache2 там, где его найдёт рабочее место, а не только root. Пакет кладёт
# бинарь в /usr/sbin, и /etc/profile отдаёт этот каталог только root: у dev<N>
# путь /usr/local/bin:/usr/bin:/bin:/usr/local/games:/usr/games. А 1c-connect
# зовёт apache2 по имени из $PATH (publication.rs), то есть при настоящем
# входе публикация базы не поднялась бы вовсе. Ссылка, а не правка PATH:
# /usr/local/bin есть во всех цепочках входа, которые тут участвуют, и от
# того, какую выберет сессия xrdp, результат не зависит.
# Проверка идёт тем же путём, каким apache2 ищет рабочее место: окружение
# вычищено, путь ровно пользовательский. Проверка под root ничего бы не
# доказала — ровно так этот дефект и дожил до стенда.
RUN ln -sf /usr/sbin/apache2 /usr/local/bin/apache2 \
    && env -i PATH=/usr/local/bin:/usr/bin:/bin sh -c 'command -v apache2'

# config/1c/stand.sh сюда НЕ копируется, хотя это и выглядит естественным
# местом. Слой payload идёт FROM tools, и правка одной строки в скрипте
# времени выполнения заставляла бы заново ставить платформу — двадцать
# пять минут за опечатку в комментарии. Поэтому он копируется ниже,
# отдельно в payload и в stand, последним слоем каждого.

# =============================================================================
# payload — the platform and the template base, for the two volumes
# =============================================================================
# Built with `--target payload`, exported with `1c-stand export-payload`, and
# never shipped as an image. Everything it produces lives under /opt/1cv8t and
# /opt/1c-demo, the two paths the volumes are mounted at.
# PLATFORM_VERSION and DEMO_DB_USER are not re-declared here: `tools` turned
# both into ENV, and an ENV always wins over an ARG of the same name, so the
# two targets cannot drift apart on the values that matter.
FROM tools AS payload

# The installer is bind-mounted, not copied: it would otherwise sit in a layer
# next to the 2.5 GB it unpacks.
RUN --mount=type=bind,from=platform,target=/platform \
    /platform/setup-training-${PLATFORM_VERSION}-x86_64.run --mode unattended --installer-language ru \
      --enable-components client_full,ws,ru \
      --disable-components v8_install_deps,desktop_icons \
    && P=/opt/1cv8t/x86_64/${PLATFORM_VERSION} && cd "$P" \
    `# the ".wk41" twins everywhere they ship: the version directory holds the` \
    `# client and the Configurator, /opt/1cv8t/common holds the starter, and` \
    `# each looks for its libraries next to itself (RUNPATH is $ORIGIN)` \
    && for w in $(find /opt/1cv8t -name '*.wk41'); do ln -sf "$(basename "$w")" "${w%.wk41}"; done \
    && ln -s 1cv8t 1cv8 && ln -s 1cv8ct 1cv8c && ln -s webinstt webinst \
    && ! ldd 1cv8t 1cv8ct webinstt wsap24t.so /opt/1cv8t/common/1cestartt | grep 'not found' \
    # Smoke test: the Configurator creates a base under Xvfb. If this fails the
    # build fails, not the demo.
    && xvfb-run -a "$P/1cv8t" CREATEINFOBASE "File=/tmp/smoke" /DisableStartupDialogs /DisableStartupMessages /Out /tmp/smoke.log \
    && test -s /tmp/smoke/1Cv8.1CD && rm -rf /tmp/smoke /tmp/smoke.log \
    && echo "platform ${PLATFORM_VERSION}: ok"

# 1c-stand нужен ниже: блок демо-базы поднимает им одноразовый Apache.
# Стоит он ИМЕННО здесь, после установки платформы, а не в начале слоя —
# иначе правка скрипта снова тянула бы за собой её переустановку.
COPY config/1c/stand.sh /usr/local/bin/1c-stand
RUN sed -i 's/\r$//' /usr/local/bin/1c-stand && chmod +x /usr/local/bin/1c-stand

# --- the demo base -----------------------------------------------------------
# One template base; every workstation gets its own copy on first use (see
# config/1c/stand.sh). Built from a configuration template in the platform
# context when one is named — DEMO_TEMPLATE=<file>, a .cf or a .dt — otherwise
# from an empty configuration: the stand still shows the tools.
# The template in use is the training УНФ 3.0.13.251 — the kit's own demo base
# WITH data (1Cv8.dt of smallBusiness_t_3_0_13_251), so the stand shows a
# configuration a person recognises, filled with records rather than empty.
#
# This corrects what stood here before. The note used to say that base cannot
# be opened under the training licence — that its users have passwords and the
# licence allows only empty ones — and because of that the stand carried an
# empty base with the welcome wizard walked by hand (unf-ready.dt). Measured
# 2026-10-21 on 8.5.1.1150, it is false: the base opens with no wizard and no
# password, and three Designer runs on it answer «Администратор» rc=0, a
# made-up name and no /N at all «The infobase user is not authenticated». The
# last run is the proof the base HAS users — a userless base lets you in
# without a name — and the first is the proof that name needs no password.
#
# So neither unf-ready.dt nor any manual clicking is needed any more, and
# DEMO_DB_USER carries that name onward: the publication, the starter's list
# and vrunner all need it.
#
# The mcp-1c extension goes in here; whether it applies is checked right away
# through a throwaway Apache, and a 404 is a warning, not a failure.
ARG DEMO_TEMPLATE=unf.dt
RUN --mount=type=bind,from=platform,target=/platform \
    P=/opt/1cv8/x86_64/${PLATFORM_VERSION} && B=/opt/1c-demo/base && mkdir -p /opt/1c-demo \
    # every Designer run prints its own log, pass or fail: a silent chain is
    # what cost the first build with a template an hour
    && D() { xvfb-run -a "$P/1cv8" "$@" /Out /tmp/d.log 2>/dev/null; rc=$?; cat /tmp/d.log; echo " [rc=$rc] $1 $2"; return $rc; } \
    # a named template that is not in the context is an error, not a quiet
    # fallback to an empty configuration: the user below belongs to it
    && if [ -n "${DEMO_TEMPLATE}" ]; then test -f "/platform/${DEMO_TEMPLATE}" || { echo "DEMO_TEMPLATE=${DEMO_TEMPLATE} is not in the platform context"; exit 1; }; tpl="/UseTemplate /platform/${DEMO_TEMPLATE}"; else tpl=""; fi \
    && N=${DEMO_DB_USER:+/N${DEMO_DB_USER}} \
    && D CREATEINFOBASE "File=$B" $tpl /DisableStartupDialogs /DisableStartupMessages \
    && test -s "$B/1Cv8.1CD" && du -sh "$B" \
    # DoNotCopy.txt is how a BSP configuration recognises a file base it has
    # been copied away from: the file holds the identifier of the base, and if
    # it is missing or holds another one, the first person in is met by
    # «Информационная база была перемещена или восстановлена из резервной
    # копии», work with external resources is locked and the window is titled
    # [КОПИЯ]. A .dt carries the identifier but not the file, so a restored
    # base has none; the one in the platform context was written by answering
    # that question once on a base restored from this very template (see the
    # README), and every workstation copy of the directory inherits it.
    # Regenerate it whenever the template is regenerated — a stale identifier
    # only brings the question back, it breaks nothing.
    && if [ -f /platform/DoNotCopy.txt ]; then cp /platform/DoNotCopy.txt "$B/"; fi \
    # Снятие с поддержки. Решение владельца продукта (спека, раздел про второй
    # акт): пока конфигурация на поддержке с запретом изменений, пообъектная
    # загрузка в базу невозможна — «Загрузка невозможна: редактирование объекта
    # метаданных Catalog.Номенклатура запрещено!» — и второй акт онбординга,
    # который возвращает правку агента в базу, показать нечем. Полная загрузка
    # проходит и на поддержке, но идёт сорок минут вместо двух.
    # Измерено на стенде 2026-10-20: само снятие 67 секунд, после него загрузка
    # одного объекта 107 секунд, и база отвечает новым синонимом.
    # Только когда база строится из шаблона: пустая конфигурация ни на какой
    # поддержке не стоит, и команда на ней осмысленно упала бы.
    && if [ -n "${DEMO_TEMPLATE}" ]; then \
         D DESIGNER /F "$B" $N /DisableStartupDialogs /DisableStartupMessages \
           /ManageCfgSupport -disableSupport -force; \
       fi \
    # two Designer runs: two -Extension keys in one command line are refused
    && D DESIGNER /F "$B" $N /DisableStartupDialogs /DisableStartupMessages \
         /LoadCfg /opt/mcp-1c/MCP_HTTPService.cfe -Extension MCP_HTTPService \
    && D DESIGNER /F "$B" $N /DisableStartupDialogs /DisableStartupMessages \
         /UpdateDBCfg -Extension MCP_HTTPService \
    && chmod -R a+rX /opt/1c-demo \
    # the check runs on a COPY, never on the template itself: whatever a
    # session writes — the configuration's own first-run bookkeeping included —
    # stays out of what every workstation is cloned from. With a template built
    # without DEMO_DB_USER this also keeps the base userless: the first session
    # of a BSP configuration creates an infobase user named after the account
    # that opened it, here www-data, and every interactive start afterwards is
    # refused with «Пользователь ИБ не идентифицирован».
    && cp -a "$B" /tmp/chk && chown -R www-data:www-data /tmp/chk \
    && 1c-stand publish www-data 8089 /tmp/chk /tmp/chk-pub \
    && apache2 -f /tmp/chk-pub/apache.conf -k start && sleep 3 \
    && code=$(curl -s -o /tmp/hs -w '%{http_code}' http://127.0.0.1:8089/base/hs/mcp-1c/version) \
    && apache2 -f /tmp/chk-pub/apache.conf -k stop && sleep 2 \
    && case "$code" in \
         200) echo "demo base: mcp-1c HTTP service answers $(tr -d ' \n' </tmp/hs)" ;; \
         404) echo "WARNING demo base: HTTP 404 — the mcp-1c extension did not apply; the stand works without the 1c tools" ;; \
         *)   echo "demo base: HTTP service http=$code"; cat /tmp/hs; exit 1 ;; \
       esac \
    && rm -rf /tmp/chk /tmp/chk-pub /tmp/hs \
    # what import-payload checks for, and what `check` reports: the two trees
    # and the versions they were built from
    && printf 'platform=%s\ndemo_template=%s\ndemo_db_user=%s\nbuilt=%s\n' \
         "${PLATFORM_VERSION}" "${DEMO_TEMPLATE:-(empty configuration)}" "${DEMO_DB_USER:-(no users)}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
         > /opt/1c-demo/payload.conf \
    && cat /opt/1c-demo/payload.conf

# =============================================================================
# stand — the image (the default target: no platform, no demo base)
# =============================================================================
# The menu entries, the check, the agent rules for this image (appended to the
# shipped AGENTS.md: the base entrypoint re-seeds homes from it by checksum),
# and the runtime as CMD. The starter is what the desktop gets; the two direct
# launchers stay in the menu for when one is wanted by itself.
FROM tools AS stand
COPY config/1c/stand.sh /usr/local/bin/1c-stand
RUN sed -i 's/\r$//' /usr/local/bin/1c-stand && chmod +x /usr/local/bin/1c-stand
COPY config/1c/start.desktop        /usr/share/applications/1c-start.desktop
COPY config/1c/configurator.desktop /usr/share/applications/1c-configurator.desktop
COPY config/1c/enterprise.desktop   /usr/share/applications/1c-enterprise.desktop
# The tray at session start. The entry is here even when the binary is not:
# `1c-stand connect` says so in the log and exits, which is better than an
# autostart entry that appears and disappears between image versions.
COPY config/1c/connect-autostart.desktop /etc/xdg/autostart/zz-1c-connect.desktop
# dev1c-onboarding: семь шагов поверх рабочего стола, см. config/1c/
# onboarding/. Тот же приём, что у 1c-connect выше — пункт меню и автозапуск
# зовут одну и ту же команду, «1c-stand onboarding», а не python3 напрямую,
# так что путь к интерпретатору и к сценарию остаётся в одном месте.
COPY config/1c/onboarding                   /opt/onboarding
COPY config/1c/onboarding.desktop           /usr/share/applications/1c-onboarding.desktop
COPY config/1c/onboarding-autostart.desktop /etc/xdg/autostart/zz-1c-onboarding.desktop
# 1c-connect for Linux, built with its window by CI (artifact `1c-connect-linux`,
# which carries the binary under its own name — `1c-connect`). ONE name on both
# sides: nothing renames the file on the way any more.
#
# Its own build context, not `platform/`: this is the only thing the stand
# image needs from outside the repository, and mounting `platform/` here would
# push the 1C installer and the demo template — about 3.8 GB — to the daemon on
# every rebuild of a 4 GB image whose whole point is being quick to rebuild.
#
# A missing file is now an ERROR, not a line in the log. Until 2026-10-25 this
# block expected the name `1c-connect-linux` while the artifact carried
# `1c-connect`, and the CI image job never downloaded that artifact at all — so
# every kit shipped a stand WITHOUT the connector's window and said so only in
# one line nobody reads. A build that deliberately goes without it has to say
# so: `--build-arg CONNECT_OPTIONAL=1`.
ARG CONNECT_OPTIONAL=0
RUN --mount=type=bind,from=artifacts,target=/artifacts \
    if [ -f /artifacts/1c-connect ]; then \
        install -D -m 0755 /artifacts/1c-connect /opt/1c-connect/1c-connect \
        && /opt/1c-connect/1c-connect --help >/dev/null \
        && echo "1c-connect: in the image"; \
    elif [ "$CONNECT_OPTIONAL" = 1 ]; then \
        echo "1c-connect: not supplied (CONNECT_OPTIONAL=1), the stand works without the window"; \
    else \
        echo "1c-connect: нет файла artifacts/1c-connect — стенд собрался бы без окна коннектора." >&2; \
        echo "Положите туда linux-сборку (артефакт CI 1c-connect-linux) или соберите с --build-arg CONNECT_OPTIONAL=1." >&2; \
        exit 1; fi
COPY config/1c/test-stand.sh /usr/local/bin/test-stand
COPY config/1c/agents-1c.md /tmp/agents-1c.md
RUN sed -i 's/\r$//' /usr/local/bin/test-stand /tmp/agents-1c.md /usr/share/applications/1c-*.desktop \
    && chmod +x /usr/local/bin/test-stand \
    `# Оба читателя правил разом: панель Zed и pi в терминале. Файл один и` \
    `# тот же, но назначений два — допишешь одному, и агенты разойдутся в` \
    `# умениях молча. Поймано проверкой test-pi 25.10.2026: в образе с 1С у` \
    `# pi не было правил про демо-стенд, платформу и стартер.` \
    && for f in /etc/skel/.config/zed/AGENTS.md /etc/skel/.pi/agent/AGENTS.md; do \
           cat /tmp/agents-1c.md >> "$f" && grep -q 'демо-стенд' "$f" || exit 1; \
       done \
    && rm /tmp/agents-1c.md \
    `# На это равенство опирается test-stand: он сверяет добавку и версию` \
    `# платформы только по копии Zed, и этого хватает ровно потому, что` \
    `# копии равны здесь. Снимете cmp — допишите в test-stand вторую` \
    `# строку про ~/.pi/agent/AGENTS.md, иначе расхождение доедет до стенда.` \
    && cmp /etc/skel/.config/zed/AGENTS.md /etc/skel/.pi/agent/AGENTS.md
CMD ["/usr/local/bin/1c-stand", "start"]
