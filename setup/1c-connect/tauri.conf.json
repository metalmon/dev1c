{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "1c-connect",
  "version": "0.1.0",
  "identifier": "ru.oktaplus.dev1c.connect",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "title": "1c-connect — подключение к среде разработки",
        "width": 1000,
        "height": 780,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
